generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["partialIndexes"]
  moduleFormat    = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id                       String                     @id(map: "uq_tenant_self") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                     String                     @unique @db.VarChar(50)
  name                     String                     @db.VarChar(200)
  legal_name               String?                    @db.VarChar(200)
  tax_code                 String?                    @db.VarChar(50)
  contact_email            String?                    @db.VarChar(255)
  contact_phone            String?                    @db.VarChar(20)
  address                  String?
  logo_url                 String?
  timezone                 String                     @default("Asia/Ho_Chi_Minh") @db.VarChar(50)
  currency                 String                     @default("VND") @db.Char(3)
  locale                   String                     @default("vi-VN") @db.VarChar(10)
  status                   String                     @default("TRIAL") @db.VarChar(20)
  suspended_at             DateTime?                  @db.Timestamptz(6)
  suspended_reason         String?
  data_retention_days      Int?
  created_by               String?                    @db.Uuid
  created_at               DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at               DateTime                   @default(now()) @db.Timestamptz(6)
  attendances              attendances[]
  branches                 Branch[]
  customer_inbody_records  customer_inbody_records[]
  customer_pt_packages     customer_pt_packages[]
  customers                Customer[]
  guest_visits             guest_visits[]
  invitations              Invitation[]
  membership_packages      MembershipPackage[]
  memberships              Membership[]
  notification_rules       notification_rules[]
  payment_accounts         payment_accounts[]
  payments                 Payment[]
  pt_bookings              PtBooking[]
  pt_package_plans         pt_package_plans[]
  pt_profiles              PtProfile[]
  saas_invoices            saas_invoices[]
  saas_payments            saas_payments[]
  services                 Service[]
  staff_profiles           staff_profiles[]
  subscriptions            Subscription?
  support_sessions         SupportSession[]
  tenant_feature_overrides tenant_feature_overrides[]
  tenant_settings          TenantSettings[]
  user_roles               user_roles[]
  users                    User[]

  @@map("tenants")
}

model OtpCode {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String    @db.Uuid
  purpose     String    @default("REGISTER_VERIFY") @db.VarChar(30)
  code_hash   String
  expires_at  DateTime  @db.Timestamptz(6)
  consumed_at DateTime? @db.Timestamptz(6)
  attempts    Int       @default(0)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)

  @@index([user_id, purpose, created_at(sort: Desc)], map: "ix_otp_codes_user")
  @@map("otp_codes")
}

/// BR-TRIAL-04: one Trial per user account (MVP anti-abuse control), history
/// kept for SuperAdmin's manual anomaly review.
model TrialHistory {
  trial_id   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  tenant_id  String   @db.Uuid
  start_at   DateTime @db.Timestamptz(6)
  end_at     DateTime @db.Timestamptz(6)
  status     String   @default("ACTIVE") @db.VarChar(20)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([user_id], map: "ix_trial_history_user")
  @@map("trial_history")
}

/// OW-04b: mời nhân sự (BM/Staff/PT). Khác OTP (gắn user_id có sẵn, mã 6 số
/// ngắn hạn) — Invitation tạo user PENDING trước, token dài hạn qua link
/// email, có thể thu hồi trước khi chấp nhận.
model Invitation {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id   String    @db.Uuid
  user_id     String    @db.Uuid
  role_code   String    @db.VarChar(30)
  branch_id   String?   @db.Uuid
  token_hash  String
  status      String    @default("PENDING") @db.VarChar(20)
  invited_by  String    @db.Uuid
  expires_at  DateTime  @db.Timestamptz(6)
  accepted_at DateTime? @db.Timestamptz(6)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  tenants     Tenant    @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenant_id, status], map: "ix_invitations_tenant")
  @@map("invitations")
}

model Addon {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                  String              @unique @db.VarChar(50)
  name                  String              @db.VarChar(150)
  description           String?
  pricing_model         String              @default("FIXED") @db.VarChar(20)
  price                 Decimal             @default(0) @db.Decimal(15, 2)
  currency              String              @default("VND") @db.Char(3)
  effect_feature_code   String?             @db.VarChar(50)
  effect_type           String?             @db.VarChar(20)
  effect_amount         Int?
  compatible_plan_codes String[]            @default([])
  status                String              @default("ACTIVE") @db.VarChar(20)
  created_at            DateTime            @default(now()) @db.Timestamptz(6)
  updated_at            DateTime            @default(now()) @db.Timestamptz(6)
  subscription_addons   SubscriptionAddon[]

  @@map("addons")
}

model SubscriptionAddon {
  subscription_id        String       @db.Uuid
  addon_id                String       @db.Uuid
  quantity                Int          @default(1)
  price_snapshot          Decimal      @db.Decimal(15, 2)
  pricing_model_snapshot  String       @db.VarChar(20)
  status                  String       @default("ACTIVE") @db.VarChar(20)
  added_by                String?      @db.Uuid
  added_at                DateTime     @default(now()) @db.Timestamptz(6)
  cancelled_by            String?      @db.Uuid
  cancelled_at            DateTime?    @db.Timestamptz(6)
  cancel_reason           String?
  subscriptions           Subscription @relation(fields: [subscription_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  addons                  Addon        @relation(fields: [addon_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([subscription_id, addon_id])
  @@map("subscription_addons")
}

model PlatformSetting {
  setting_key   String   @id @db.VarChar(100)
  setting_value Json
  updated_by    String?  @db.Uuid
  updated_at    DateTime @default(now()) @db.Timestamptz(6)

  @@map("platform_settings")
}

model SupportSession {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id       String    @db.Uuid
  actor_user_id   String    @db.Uuid
  target_user_id  String    @db.Uuid
  access_level    String    @default("READ_ONLY") @db.VarChar(20)
  scope           String[]  @default([])
  reason          String
  status          String    @default("ACTIVE") @db.VarChar(20)
  started_at      DateTime  @default(now()) @db.Timestamptz(6)
  expires_at      DateTime  @db.Timestamptz(6)
  ended_at        DateTime? @db.Timestamptz(6)
  ended_by        String?   @db.Uuid
  end_reason      String?
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  tenants         Tenant    @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenant_id, started_at(sort: Desc)], map: "ix_support_sessions_tenant")
  @@map("support_sessions")
}

model TenantSettings {
  tenant_id     String   @db.Uuid
  setting_key   String   @db.VarChar(100)
  setting_value Json
  updated_by    String?  @db.Uuid
  updated_at    DateTime @default(now()) @db.Timestamptz(6)
  tenants       Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([tenant_id, setting_key])
  @@map("tenant_settings")
}

model PlatformFeature {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code               String            @unique @db.VarChar(50)
  name               String            @db.VarChar(100)
  description        String?
  feature_type       String            @db.VarChar(20)
  module             String?           @db.VarChar(50)
  created_at         DateTime          @default(now()) @db.Timestamptz(6)
  saas_plan_features SaasPlanFeature[]

  @@map("platform_features")
}

model SaasPlan {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                 String            @unique @db.VarChar(30)
  name                 String            @db.VarChar(100)
  description          String?
  billing_cycle        String            @default("MONTHLY") @db.VarChar(20)
  price                Decimal           @default(0) @db.Decimal(15, 2)
  currency             String            @default("VND") @db.Char(3)
  trial_days           Int               @default(0)
  display_order        Int               @default(0)
  is_public            Boolean           @default(true)
  status               String            @default("ACTIVE") @db.VarChar(20)
  created_at           DateTime          @default(now()) @db.Timestamptz(6)
  updated_at           DateTime          @default(now()) @db.Timestamptz(6)
  billing_cycle_months Int?              @db.SmallInt
  saas_plan_features   SaasPlanFeature[]
  subscriptions        Subscription[]
  target_plan_invoices saas_invoices[]

  @@map("saas_plans")
}

model SaasPlanFeature {
  plan_id           String          @db.Uuid
  feature_id        String          @db.Uuid
  is_enabled        Boolean         @default(false)
  quota_value       Int?
  platform_features PlatformFeature @relation(fields: [feature_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  saas_plans        SaasPlan        @relation(fields: [plan_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([plan_id, feature_id])
  @@map("saas_plan_features")
}

model Subscription {
  id                       String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id                String                  @unique(map: "uq_sub_one_current", where: raw("((status)::text = ANY ((ARRAY['TRIAL'::character varying, 'ACTIVE'::character varying, 'PAST_DUE'::character varying])::text[]))")) @db.Uuid
  plan_id                  String                  @db.Uuid
  status                   String                  @default("TRIAL") @db.VarChar(20)
  start_date               DateTime                @db.Date
  end_date                 DateTime                @db.Date
  trial_ends_at            DateTime?               @db.Date
  billing_cycle            String                  @default("MONTHLY") @db.VarChar(20)
  price                    Decimal                 @default(0) @db.Decimal(15, 2)
  currency                 String                  @default("VND") @db.Char(3)
  auto_renew               Boolean                 @default(true)
  previous_subscription_id String?                 @db.Uuid
  cancelled_at             DateTime?               @db.Timestamptz(6)
  cancel_reason            String?
  created_by               String?                 @db.Uuid
  created_at               DateTime                @default(now()) @db.Timestamptz(6)
  updated_at               DateTime                @default(now()) @db.Timestamptz(6)
  billing_cycle_months     Int?                    @db.SmallInt
  saas_invoices            saas_invoices[]
  subscription_addons      SubscriptionAddon[]
  subscription_features    subscription_features[]
  saas_plans               SaasPlan                @relation(fields: [plan_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subscriptions            Subscription?           @relation("subscriptionsTosubscriptions", fields: [previous_subscription_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_subscriptions      Subscription[]          @relation("subscriptionsTosubscriptions")
  tenants                  Tenant                  @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("subscriptions")
}

model Branch {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id            String                 @db.Uuid
  code                 String                 @db.VarChar(50)
  name                 String                 @db.VarChar(200)
  address              String?
  phone                String?                @db.VarChar(20)
  email                String?                @db.VarChar(255)
  opening_days         String                 @default("Thứ 2 - Chủ nhật") @db.VarChar(100)
  latitude             Decimal?               @db.Decimal(10, 7)
  longitude            Decimal?               @db.Decimal(10, 7)
  opening_time         DateTime               @default(dbgenerated("'05:00:00'::time without time zone")) @db.Time(6)
  closing_time         DateTime               @default(dbgenerated("'22:00:00'::time without time zone")) @db.Time(6)
  timezone             String?                @db.VarChar(50)
  status               String                 @default("ACTIVE") @db.VarChar(20)
  deactivated_at       DateTime?              @db.Timestamptz(6)
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  updated_at           DateTime               @default(now()) @db.Timestamptz(6)
  attendances          attendances[]
  branch_settings      branch_settings[]
  tenants              Tenant                 @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  checkin_devices      checkin_devices[]
  customer_pt_packages customer_pt_packages[]
  customers            Customer[]
  guest_visits         guest_visits[]
  memberships          Membership[]
  package_branches     package_branches[]
  package_prices       package_prices[]
  payment_accounts     payment_accounts[]
  payments             Payment[]
  pt_bookings          PtBooking[]
  pt_working_hours     pt_working_hours[]
  user_branches        user_branches[]

  @@unique([tenant_id, code])
  @@unique([tenant_id, id], map: "uq_branch_tenant")
  @@map("branches")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model User {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id      String?         @db.Uuid
  user_type      String          @db.VarChar(20)
  email          String?         @db.VarChar(255)
  phone          String?         @db.VarChar(20)
  password_hash  String?
  full_name      String          @db.VarChar(150)
  avatar_url     String?
  date_of_birth  DateTime?       @db.Date
  gender         String?         @db.VarChar(10)
  status         String          @default("ACTIVE") @db.VarChar(20)
  has_used_trial       Boolean         @default(false)
  must_change_password Boolean         @default(false)
  last_login_at        DateTime?       @db.Timestamptz(6)
  deactivated_at DateTime?       @db.Timestamptz(6)
  created_by     String?         @db.Uuid
  created_at     DateTime        @default(now()) @db.Timestamptz(6)
  updated_at     DateTime        @default(now()) @db.Timestamptz(6)
  customers      Customer[]
  pt_profiles    PtProfile?
  staff_profiles staff_profiles?
  user_branches  user_branches[]
  user_roles     user_roles[]
  tenants        Tenant?         @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenant_id, phone], map: "uq_user_phone_tenant", where: raw("((phone IS NOT NULL) AND (tenant_id IS NOT NULL))"))
  @@unique([tenant_id, id], map: "uq_user_tenant")
  @@map("users")
}

model PtProfile {
  user_id          String             @id @db.Uuid
  tenant_id        String             @db.Uuid
  employee_code    String?            @db.VarChar(50)
  bio              String?
  specialties      String[]
  experience_years Int?
  hire_date        DateTime?          @db.Date
  rating_avg       Decimal?           @db.Decimal(3, 2)
  max_clients      Int?
  note             String?
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  pt_certificates  pt_certificates[]
  pt_package_plans pt_package_plans[]
  tenants          Tenant             @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users            User               @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  pt_working_hours pt_working_hours[]

  @@unique([tenant_id, employee_code])
  @@map("pt_profiles")
}

model Customer {
  id                      String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id               String                @db.Uuid
  user_id                 String?               @db.Uuid
  customer_code           String                @db.VarChar(50)
  full_name               String                @db.VarChar(150)
  phone                   String?               @db.VarChar(20)
  email                   String?               @db.VarChar(255)
  date_of_birth           DateTime?             @db.Date
  gender                  String?               @db.VarChar(10)
  address                 String?
  avatar_url              String?
  home_branch_id          String?               @db.Uuid
  qr_token                String                @unique @default(dbgenerated("encode(gen_random_bytes(24), 'hex'::text)")) @db.VarChar(64)
  qr_token_version        Int                   @default(1)
  face_consent_at         DateTime?             @db.Timestamptz(6)
  face_consent_ip         String?               @db.Inet
  first_seen_as           String?               @db.VarChar(10)
  emergency_contact_name  String?               @db.VarChar(150)
  emergency_contact_phone String?               @db.VarChar(20)
  health_note             String?
  status                  String                @default("ACTIVE") @db.VarChar(20)
  created_by              String?               @db.Uuid
  created_at              DateTime              @default(now()) @db.Timestamptz(6)
  updated_at              DateTime              @default(now()) @db.Timestamptz(6)
  attendances             attendances[]
  customer_pt_packages    customer_pt_packages[]
  tenants                 Tenant                @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branches                Branch?               @relation(fields: [tenant_id, home_branch_id], references: [tenant_id, id], onDelete: NoAction, onUpdate: NoAction)
  users                   User?                 @relation(fields: [tenant_id, user_id], references: [tenant_id, id], onDelete: NoAction, onUpdate: NoAction)
  face_profiles           face_profiles[]
  guest_visits            guest_visits[]
  memberships             Membership[]
  payments                Payment[]
  pt_bookings             PtBooking[]
  customer_inbody_records customer_inbody_records[]

  @@unique([tenant_id, customer_code])
  @@unique([tenant_id, phone], map: "uq_customer_phone", where: raw("(phone IS NOT NULL)"))
  @@unique([tenant_id, id], map: "uq_customer_tenant")
  @@index([full_name(ops: raw("gin_trgm_ops"))], map: "ix_customer_name_trgm", type: Gin)
  @@map("customers")
}

model Service {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id        String             @db.Uuid
  code             String             @db.VarChar(50)
  name             String             @db.VarChar(150)
  description      String?
  icon_url         String?
  status           String             @default("ACTIVE") @db.VarChar(20)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  package_services package_services[]
  tenants          Tenant             @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenant_id, code])
  @@unique([tenant_id, id], map: "uq_service_tenant")
  @@map("services")
}

model MembershipPackage {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id            String             @db.Uuid
  code                 String             @db.VarChar(50)
  name                 String             @db.VarChar(150)
  description          String?
  package_type         String             @default("MEMBERSHIP") @db.VarChar(20)
  duration_value       Int
  duration_unit        String             @db.VarChar(10)
  branch_access_scope  String             @default("HOME_BRANCH") @db.VarChar(20)
  max_checkins_per_day Int?
  base_price           Decimal            @db.Decimal(15, 2)
  currency             String             @default("VND") @db.Char(3)
  freeze_allowed_days  Int                @default(0)
  display_order        Int                @default(0)
  status               String             @default("ACTIVE") @db.VarChar(20)
  created_by           String?            @db.Uuid
  created_at           DateTime           @default(now()) @db.Timestamptz(6)
  updated_at           DateTime           @default(now()) @db.Timestamptz(6)
  guest_visits         guest_visits[]
  tenants              Tenant             @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  memberships          Membership[]
  package_branches     package_branches[]
  package_prices       package_prices[]
  package_services     package_services[]

  @@unique([tenant_id, code])
  @@unique([tenant_id, id], map: "uq_pkg_tenant")
  @@map("membership_packages")
}

model Membership {
  id                            String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id                     String                 @db.Uuid
  customer_id                   String                 @unique(map: "uq_membership_one_open", where: raw("((status)::text = ANY ((ARRAY['SCHEDULED'::character varying, 'ACTIVE'::character varying, 'FROZEN'::character varying])::text[]))")) @db.Uuid
  package_id                    String                 @db.Uuid
  branch_id                     String                 @db.Uuid
  membership_no                 String                 @db.VarChar(50)
  package_name_snapshot         String                 @db.VarChar(150)
  price_snapshot                Decimal                @db.Decimal(15, 2)
  currency_snapshot             String                 @default("VND") @db.Char(3)
  duration_value_snapshot       Int
  duration_unit_snapshot        String                 @db.VarChar(10)
  branch_access_scope_snapshot  String                 @db.VarChar(20)
  max_checkins_per_day_snapshot Int?
  start_date                    DateTime               @db.Date
  end_date                      DateTime               @db.Date
  status                        String                 @default("SCHEDULED") @db.VarChar(20)
  frozen_days_used              Int                    @default(0)
  previous_membership_id        String?                @db.Uuid
  sold_by                       String?                @db.Uuid
  activated_at                  DateTime?              @db.Timestamptz(6)
  cancelled_at                  DateTime?              @db.Timestamptz(6)
  cancel_reason                 String?
  created_at                    DateTime               @default(now()) @db.Timestamptz(6)
  updated_at                    DateTime               @default(now()) @db.Timestamptz(6)
  attendances                   attendances[]
  customer_pt_packages          customer_pt_packages[]
  membership_freezes            membership_freezes[]
  memberships                   Membership?            @relation("membershipsTomemberships", fields: [previous_membership_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_memberships             Membership[]           @relation("membershipsTomemberships")
  branches                      Branch                 @relation(fields: [tenant_id, branch_id], references: [tenant_id, id], onDelete: NoAction, onUpdate: NoAction)
  customers                     Customer               @relation(fields: [tenant_id, customer_id], references: [tenant_id, id], onDelete: NoAction, onUpdate: NoAction)
  tenants                       Tenant                 @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  membership_packages           MembershipPackage      @relation(fields: [tenant_id, package_id], references: [tenant_id, id], onDelete: NoAction, onUpdate: NoAction)
  payment_items                 payment_items[]

  @@unique([tenant_id, membership_no])
  @@unique([tenant_id, id], map: "uq_membership_tenant")
  @@index([tenant_id, end_date], map: "ix_membership_expiring", where: raw("((status)::text = 'ACTIVE'::text)"))
  @@map("memberships")
}

model PtBooking {
  id                     String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id              String               @db.Uuid
  branch_id              String               @db.Uuid
  pt_user_id             String               @db.Uuid
  customer_id            String               @db.Uuid
  customer_pt_package_id String               @db.Uuid
  scheduled_start        DateTime             @db.Timestamptz(6)
  scheduled_end          DateTime             @db.Timestamptz(6)
  status                 String               @default("SCHEDULED") @db.VarChar(20)
  actual_start           DateTime?            @db.Timestamptz(6)
  actual_end             DateTime?            @db.Timestamptz(6)
  completed_at           DateTime?            @db.Timestamptz(6)
  completed_by           String?              @db.Uuid
  session_note           String?
  cancelled_at           DateTime?            @db.Timestamptz(6)
  cancelled_by           String?              @db.Uuid
